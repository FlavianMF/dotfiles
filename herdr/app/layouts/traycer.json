{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "left-tabs",
              "type": "stack",
              "active": "over9k",
              "size": {
                "weight": 2
              },
              "min": 160,
              "children": [
                {
                  "id": "over9k",
                  "type": "block",
                  "content": {
                    "mod": "over9k"
                  }
                },
                {
                  "id": "filetree",
                  "type": "block",
                  "content": {
                    "mod": "filetree"
                  }
                }
              ],
              "header": {
                "content": {
                  "mod": "lower-tabs",
                  "props": {
                    "stack": "left-tabs",
                    "bg": "chrome",
                    "tabs": [
                      [
                        "over9k",
                        "Projetos"
                      ],
                      [
                        "filetree",
                        "Arquivos"
                      ]
                    ]
                  }
                },
                "reveal": "always",
                "height": 30,
                "position": "top"
              }
            },
            {
              "id": "cache-hit",
              "type": "block",
              "content": {
                "mod": "cache-hit"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              },
              "size": {
                "weight": 3
              }
            },
            {
              "id": "side",
              "type": "column",
              "children": [
                {
                  "id": "lower",
                  "type": "stack",
                  "children": [
                    {
                      "id": "agenttrail",
                      "type": "block",
                      "content": {
                        "mod": "agenttrail",
                        "props": {
                          "port": 5330
                        }
                      }
                    }
                  ],
                  "active": "agenttrail",
                  "header": {
                    "content": {
                      "mod": "lower-tabs",
                      "props": {
                        "stack": "lower",
                        "tabs": [
                          [
                            "agenttrail",
                            "Agenttrail"
                          ]
                        ]
                      }
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "size": {
                    "weight": 1
                  },
                  "min": 140
                }
              ],
              "size": {
                "weight": 2
              },
              "min": 360,
              "max": 900,
              "gap": 8
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "usage",
          "type": "block",
          "content": {
            "mod": "over9k-usage"
          },
          "size": {
            "px": 30
          }
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
