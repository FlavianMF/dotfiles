+// ADAPTADO para dotfiles: o título da própria sessão (/rename vence o título automático), para duas sessões na mesma
+// aba terem cada uma o seu nome na lista Agents. Lido do transcript a cada 10 s no máximo.
+let titleRead = { at: 0, value: null as string | null }
+async function sessionTitle($: $): Promise<string | null> {
+  if (Date.now() - titleRead.at < 10_000) return titleRead.value
+  titleRead = { ...titleRead, at: Date.now() }
+  const cwd = await $.session.cwd()
+  if (!cwd) return titleRead.value
+  const file = transcriptPath(await home($), cwd, await $.session.id())
+  const script = `for k in customTitle aiTitle; do t=$(grep -o "\\"$k\\":\\"[^\\"]*\\"" "$1" 2>/dev/null | tail -1 | cut -d'"' -f4); [ -n "$t" ] && { printf '%s' "$t"; exit 0; }; done`
+  const found = await $.process.run(['sh', '-c', script, 'sh', file], { timeoutMs: 5_000 }).catch(() => undefined)
+  titleRead = { at: Date.now(), value: found?.exitCode === 0 && found.stdout.trim() ? found.stdout.trim() : null }
+  return titleRead.value
+}
