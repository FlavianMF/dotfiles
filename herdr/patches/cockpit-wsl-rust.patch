+    ["/proc/net/tcp", "/proc/net/tcp6"].iter().filter_map(|f| std::fs::read_to_string(f).ok()).collect()
+}
+
+#[cfg(target_os = "linux")]
+fn parse_proc_net_addr(addr: &str) -> Option<(&str, u16)> {
+    let (ip, hex_port) = addr.rsplit_once(':')?;
+    let port = u16::from_str_radix(hex_port, 16).ok()?;
+    Some((ip, port))
+}
+
+#[cfg(target_os = "linux")]
+fn is_loopback_hex(ip: &str) -> bool {
+    match ip.len() {
+        8 => u32::from_str_radix(ip, 16).is_ok_and(|w| std::net::Ipv4Addr::from(w.to_ne_bytes()).is_loopback()),
+        32 => {
+            let mut bytes = [0u8; 16];
+            for (i, slot) in bytes.chunks_exact_mut(4).enumerate() {
+                let Ok(w) = u32::from_str_radix(&ip[i * 8..(i + 1) * 8], 16) else {
+                    return false;
+                };
+                slot.copy_from_slice(&w.to_ne_bytes());
+            }
+            let v6 = std::net::Ipv6Addr::from(bytes);
+            v6.is_loopback() || v6.to_ipv4_mapped().is_some_and(|v4| v4.is_loopback())
+        }
+        _ => false,
+    }
+}
+
+/// Detect a mirrored WSL2 Windows-host loopback connection: the hub has an
+/// established loopback socket `(local = hub, rem = port, st = 01)` while no
+/// Linux-side client socket `(local = port, rem = hub)` exists in `/proc/net/tcp*`.
+#[cfg(target_os = "linux")]
+fn wsl_host_tcp_in(tables: &[&str], port: u16, hub: u16) -> bool {
+    let mut has_server = false;
+    for text in tables {
+        for line in text.lines().skip(1) {
+            let w: Vec<&str> = line.split_whitespace().collect();
+            if w.len() <= 3 {
+                continue;
+            }
+            let Some((lip, lport)) = parse_proc_net_addr(w[1]) else { continue };
+            let Some((rip, rport)) = parse_proc_net_addr(w[2]) else { continue };
+            if lport == port && rport == hub {
+                return false;
+            }
+            if w[3] == "01" && lport == hub && rport == port && is_loopback_hex(lip) && is_loopback_hex(rip) {
+                has_server = true;
+            }
+        }
+    }
+    has_server
+}
