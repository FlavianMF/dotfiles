+        );
+        assert!(!wsl_host_tcp_in(&[&with_linux_client], 0xEA61, 0xB1E7));
+
+        let non_loopback = format!(
+            "{header}\n   0: C0A80102:B1E7 C0A80103:EA61 01 00000000:00000000 00:00000000 00000000  1000        0 999 1 0000000000000000 20 4 30 10 -1"
+        );
+        assert!(!wsl_host_tcp_in(&[&non_loopback], 0xEA61, 0xB1E7));
+    }
