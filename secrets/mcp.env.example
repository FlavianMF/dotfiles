# Copie para secrets/mcp.env (gitignored) e preencha com seu token pessoal.
# Carregado pelo ~/.zshrc; define as variáveis de conexão com o Home Assistant via Tailscale.
# Usado pelo ha-mcp para Claude Code, Gemini CLI / Antigravity, OpenCode e Cursor.

export HOMEASSISTANT_URL="http://100.105.143.75:8123"

# Gere um Long-Lived Access Token no Home Assistant:
# Perfil (canto inferior esquerdo) -> Segurança -> Tokens de Acesso de Longa Duração -> Criar Token
export HOMEASSISTANT_TOKEN=""
