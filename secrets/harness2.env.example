# Harness² environment configuration template
# Copy to ~/dotfiles/secrets/harness2.env (sourced automatically by zsh/.zshrc)
# or to $HARNESS2_HOME/.env

# Google Cloud / Vertex AI (default improver / evaluator backend)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Executor models (OpenCode provider/model syntax: e.g. opencode/gemini-2.5-pro, google/gemini-2.5-flash)
HARNESS2_SOLVER_MODEL=
HARNESS2_JUDGE_MODEL=

# Improver model (optional; defaults to solver model if empty)
HARNESS2_IMPROVER_MODEL=

# Runs output directory (defaults to $HARNESS2_HOME/runs if empty)
HARNESS2_RUNS_DIR=

# Proposer channel configuration (optional: opencode | claude_cli | traycer)
# HARNESS2_PROPOSER_CHANNEL=traycer
# HARNESS2_PROPOSER_MODEL=antigravity:gemini-3.8-flash

# Optional Codex Responses API / container bridge settings (via harness2-bridge)
HARNESS2_CODEX_BASE_URL=
HARNESS2_CODEX_CONTAINER_URL=
HARNESS2_CODEX_API_KEY=
HARNESS2_CODEX_MODEL=

# Optional JobBench judge endpoint override
HARNESS2_JUDGE_BASE_URL=
HARNESS2_JUDGE_API_KEY=
