{
  "$schema": "https://raw.githubusercontent.com/hass-agent/HASS.Agent/main/schema/commands.schema.json",
  "version": 1,
  "description": "Catalogo declarativo de comandos para o HASS.Agent no Windows 11",
  "commands": [
    {
      "id": "pc_shutdown",
      "name": "pc_shutdown",
      "friendly_name": "Desligar Computador",
      "description": "Desliga o computador com aviso de 10 segundos para seguranca",
      "entity_type": "Button",
      "command_type": "Shutdown",
      "executable": "shutdown.exe",
      "arguments": "/s /t 10 /c \"Desligamento acionado remotamente via Home Assistant\""
    },
    {
      "id": "pc_shutdown_abort",
      "name": "pc_shutdown_abort",
      "friendly_name": "Cancelar Desligamento",
      "description": "Cancela a contagem regressiva de desligamento em andamento",
      "entity_type": "Button",
      "command_type": "Custom",
      "executable": "shutdown.exe",
      "arguments": "/a"
    },
    {
      "id": "pc_restart",
      "name": "pc_restart",
      "friendly_name": "Reiniciar Computador",
      "description": "Reinicia o sistema imediatamente",
      "entity_type": "Button",
      "command_type": "Restart",
      "executable": "shutdown.exe",
      "arguments": "/r /t 0 /f"
    },
    {
      "id": "pc_sleep",
      "name": "pc_sleep",
      "friendly_name": "Suspender Computador",
      "description": "Coloca o computador em suspensao (Sleep / Standby)",
      "entity_type": "Button",
      "command_type": "Sleep",
      "executable": "rundll32.exe",
      "arguments": "powrprof.dll,SetSuspendState 0,1,0"
    },
    {
      "id": "pc_lock",
      "name": "pc_lock",
      "friendly_name": "Bloquear Sessao",
      "description": "Bloqueia a estacao de trabalho (Win + L)",
      "entity_type": "Button",
      "command_type": "Lock",
      "executable": "rundll32.exe",
      "arguments": "user32.dll,LockWorkStation"
    },
    {
      "id": "pc_app_obsidian",
      "name": "pc_app_obsidian",
      "friendly_name": "Abrir Obsidian",
      "description": "Inicia o Obsidian Vault",
      "entity_type": "Button",
      "command_type": "Custom",
      "executable": "powershell.exe",
      "arguments": "-NoProfile -WindowStyle Hidden -Command \"Start-Process obsidian\""
    },
    {
      "id": "pc_app_terminal",
      "name": "pc_app_terminal",
      "friendly_name": "Abrir Windows Terminal",
      "description": "Inicia o Windows Terminal",
      "entity_type": "Button",
      "command_type": "Custom",
      "executable": "powershell.exe",
      "arguments": "-NoProfile -WindowStyle Hidden -Command \"Start-Process wt\""
    },
    {
      "id": "pc_mode_eco",
      "name": "pc_mode_eco",
      "friendly_name": "Perfil Energia: Eco",
      "description": "Aplica perfil Economia de Energia via tarefa agendada pc-ctl-power",
      "entity_type": "Button",
      "command_type": "PowerShell",
      "executable": "powershell.exe",
      "arguments": "-NoProfile -ExecutionPolicy Bypass -Command \"Set-Content -Path 'C:\\ProgramData\\pc-ctl\\request.json' -Value '{\\\"profile\\\":\\\"eco\\\"}'; Start-Process schtasks.exe -ArgumentList '/run','/tn','pc-ctl-power' -NoNewWindow\""
    },
    {
      "id": "pc_mode_balanced",
      "name": "pc_mode_balanced",
      "friendly_name": "Perfil Energia: Equilibrado",
      "description": "Aplica perfil Equilibrado via tarefa agendada pc-ctl-power",
      "entity_type": "Button",
      "command_type": "PowerShell",
      "executable": "powershell.exe",
      "arguments": "-NoProfile -ExecutionPolicy Bypass -Command \"Set-Content -Path 'C:\\ProgramData\\pc-ctl\\request.json' -Value '{\\\"profile\\\":\\\"balanced\\\"}'; Start-Process schtasks.exe -ArgumentList '/run','/tn','pc-ctl-power' -NoNewWindow\""
    },
    {
      "id": "pc_mode_llm_boost",
      "name": "pc_mode_llm_boost",
      "friendly_name": "Perfil Energia: LLM Boost",
      "description": "Aplica perfil LLM Boost via tarefa agendada pc-ctl-power",
      "entity_type": "Button",
      "command_type": "PowerShell",
      "executable": "powershell.exe",
      "arguments": "-NoProfile -ExecutionPolicy Bypass -Command \"Set-Content -Path 'C:\\ProgramData\\pc-ctl\\request.json' -Value '{\\\"profile\\\":\\\"llm-boost\\\",\\\"ttl_minutes\\\":120}'; Start-Process schtasks.exe -ArgumentList '/run','/tn','pc-ctl-power' -NoNewWindow\""
    },
    {
      "id": "pc_mode_max",
      "name": "pc_mode_max",
      "friendly_name": "Perfil Energia: Maximo",
      "description": "Aplica perfil Desempenho Maximo via tarefa agendada pc-ctl-power",
      "entity_type": "Button",
      "command_type": "PowerShell",
      "executable": "powershell.exe",
      "arguments": "-NoProfile -ExecutionPolicy Bypass -Command \"Set-Content -Path 'C:\\ProgramData\\pc-ctl\\request.json' -Value '{\\\"profile\\\":\\\"max\\\",\\\"ttl_minutes\\\":120}'; Start-Process schtasks.exe -ArgumentList '/run','/tn','pc-ctl-power' -NoNewWindow\""
    },
    {
      "id": "pc_status_traycer",
      "name": "pc_status_traycer",
      "friendly_name": "Status do Traycer",
      "description": "Verifica se o processo do Traycer Desktop esta em execucao",
      "entity_type": "Sensor",
      "command_type": "PowerShell",
      "executable": "powershell.exe",
      "arguments": "-NoProfile -ExecutionPolicy Bypass -Command \"if (Get-Process -Name 'traycer-desktop','traycer' -ErrorAction SilentlyContinue) { 'Running' } else { 'Stopped' }\""
    },
    {
      "id": "pc_wsl_terminal",
      "name": "pc_wsl_terminal",
      "friendly_name": "Abrir Terminal WSL2",
      "description": "Abre um terminal da distribuicao Ubuntu do WSL2 no Windows Terminal",
      "entity_type": "Button",
      "command_type": "Custom",
      "executable": "wt.exe",
      "arguments": "wsl.exe -d Ubuntu"
    },
    {
      "id": "pc_wsl_claude",
      "name": "pc_wsl_claude",
      "friendly_name": "Abrir Claude Code no WSL2",
      "description": "Abre o Claude Code no WSL2, no diretorio ~/dotfiles",
      "entity_type": "Button",
      "command_type": "Custom",
      "executable": "wt.exe",
      "arguments": "wsl.exe -d Ubuntu --cd ~/dotfiles -- bash -lc claude"
    },
    {
      "id": "pc_wsl_obsidian",
      "name": "pc_wsl_obsidian",
      "friendly_name": "Abrir Obsidian do WSL2",
      "description": "Inicia o Obsidian instalado no WSL2 (via WSLg)",
      "entity_type": "Button",
      "command_type": "Custom",
      "executable": "powershell.exe",
      "arguments": "-NoProfile -WindowStyle Hidden -Command \"Start-Process wsl.exe -WindowStyle Hidden -ArgumentList '-d','Ubuntu','--','bash','-lc','obsidian'\""
    }
  ]
}
