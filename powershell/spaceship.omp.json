{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "foreground": "white",
          "background": "transparent",
          "template": "{{ .UserName }}"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "cyan",
          "background": "transparent",
          "template": "{{ .Path }}",
          "properties": {
            "style": "folder",
            "max_depth": 3
          }
        },
        {
          "type": "os",
          "style": "plain",
          "foreground": "white",
          "background": "transparent",
          "template": "{{ .HostName }}"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "blue",
          "background": "transparent",
          "template": "{{ .UpstreamIcon }}{{ .HEAD }}{{ if .Working }} *{{ end }}",
          "properties": {
            "fetch_upstream_icon": true
          }
        },
        {
          "type": "command_duration",
          "style": "plain",
          "foreground": "yellow",
          "background": "transparent",
          "template": "{{ .FormattedDuration }}",
          "properties": {
            "threshold": 500
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "transparent",
          "background": "transparent",
          "template": "\n"
        },
        {
          "type": "exit",
          "style": "plain",
          "foreground": "red",
          "background": "transparent",
          "template": "[{{ .Code }}]",
          "properties": {
            "always_enabled": false
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "green",
          "background": "transparent",
          "template": "❯ "
        }
      ]
    }
  ]
}
