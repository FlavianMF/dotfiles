{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "{env:OLLAMA_BASE_URL}",
        "apiKey": "ollama"
      },
      "models": {
        "qwen3.5-4b-capella:latest": {
          "name": "Qwen3.5 4B Capella (local)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "qwen3.5:4b": {
          "name": "Qwen3.5 4B (local)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 8192,
            "output": 8192
          }
        },
        "qwen3-8b-capella:latest": {
          "name": "Qwen3 8B Capella (local)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 12288,
            "output": 8192
          }
        },
        "qwen3:8b": {
          "name": "Qwen3 8B (local)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 8192,
            "output": 8192
          }
        },
        "deepseek-r1-capella:latest": {
          "name": "DeepSeek-R1 8B Capella (local)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 12288,
            "output": 8192
          }
        },
        "deepseek-r1:8b": {
          "name": "DeepSeek-R1 8B (local)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 8192,
            "output": 8192
          }
        },
        "phi4-mini:3.8b": {
          "name": "Phi-4 Mini 3.8B (local)",
          "tool_call": true,
          "limit": {
            "context": 8192,
            "output": 8192
          }
        },
        "qwen3.8-capella:latest": {
          "name": "Qwen3.8 27B Capella (local, split CPU/GPU)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 16384,
            "output": 8192
          }
        },
        "qwen3.8:latest": {
          "name": "Qwen3.8 27B (local, split CPU/GPU)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 8192,
            "output": 8192
          }
        }
      }
    },
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (WSL2, local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "llamacpp"
      },
      "models": {
        "gpt-oss-20b": {
          "name": "gpt-oss-20b MXFP4 (llama.cpp, MoE offload)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "repos,issues,pull_requests"
      }
    },
    "rea": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "rea-agents@6.4.0",
        "mcp"
      ],
      "enabled": true,
      "environment": {
        "HOPPER_LAUNCHER_PATH": "/opt/hopper/bin/Hopper"
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "~/dotfiles/secrets/**": "deny"
    },
    "edit": {
      "*": "ask",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/dotfiles/secrets/**": "deny"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "ls*": "allow",
      "pwd": "allow",
      "rg *": "allow",
      "curl * | bash*": "deny",
      "curl * | sh*": "deny",
      "curl *|bash*": "deny",
      "curl *|sh*": "deny",
      "wget * | bash*": "deny",
      "wget * | sh*": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "nc *": "deny",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "rm -Rf*": "deny",
      "rm -rF*": "deny",
      "rm -r -f*": "deny",
      "rm -f -r*": "deny",
      "sudo": "deny",
      "sudo *": "deny",
      "chmod 777*": "deny",
      "chmod -R 777*": "deny"
    }
  }
}
