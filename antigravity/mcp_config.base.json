{
  "mcpServers": {
    "figma": {
      "serverUrl": "https://mcp.figma.com/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "rea": {
      "command": "npx",
      "args": ["-y", "rea-agents@6.4.0", "mcp"],
      "env": {
        "HOPPER_LAUNCHER_PATH": "/opt/hopper/bin/Hopper"
      }
    }
  }
}
