{
  "second-brain": {
    "SessionStart": [
      { "type": "command", "command": "\"@REPO@/antigravity/hooks/second-brain-session-start.sh\"" }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "command": "\"@REPO@/antigravity/hooks/second-brain-count.sh\"" },
          { "command": "\"@REPO@/antigravity/hooks/second-brain-note-opened.sh\"" }
        ]
      }
    ],
    "Stop": [
      { "type": "command", "command": "\"@REPO@/antigravity/hooks/second-brain-stop.sh\"" }
    ]
  }
}
