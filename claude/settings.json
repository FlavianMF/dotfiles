{
  "env": {
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "SECOND_BRAIN_HOOKS": "1",
    "JEV_MODE_E": "shadow",
    "ECC_HOOK_PROFILE": "minimal",
    "ECC_DISABLED_HOOKS": "stop:evaluate-session,post:ecc-metrics-bridge"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.tmux/plugins/tmux-claude-monitor/hooks/claude-state.sh\" SessionStart",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/second-brain-session-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.tmux/plugins/tmux-claude-monitor/hooks/claude-state.sh\" UserPromptSubmit",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/jev-e.sh\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.tmux/plugins/tmux-claude-monitor/hooks/claude-state.sh\" PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.tmux/plugins/tmux-claude-monitor/hooks/claude-state.sh\" Notification",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.tmux/plugins/tmux-claude-monitor/hooks/claude-state.sh\" Stop",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/format-typecheck.sh\"",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/second-brain-stop.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.tmux/plugins/tmux-claude-monitor/hooks/claude-state.sh\" SessionEnd",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/suggest-compact.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "figma@claude-plugins-official": true,
    "fast-jev-compaction@fast-jev-compaction": true,
    "typesafe@typesafe-ai": true,
    "mattpocock-skills@claude-plugins-official": true,
    "impeccable@impeccable": true,
    "github@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "ecc@ecc": false
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      },
      "autoUpdate": false
    },
    "fast-jev-compaction": {
      "source": {
        "source": "github",
        "repo": "tamaratran/fast-jev-compaction"
      },
      "autoUpdate": false
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      },
      "autoUpdate": false
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      },
      "autoUpdate": false
    },
    "ecc": {
      "source": {
        "source": "github",
        "repo": "affaan-m/ECC"
      },
      "autoUpdate": false
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    }
  },
  "theme": "dark",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/.env*)",
      "Read(~/dotfiles/secrets/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Bash(curl * | bash)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(nc *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -rF *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\"",
    "padding": 0
  },
  "pluginConfigs": {
    "ecc@ecc": {
      "options": {
        "hooks_enabled": true,
        "hook_profile": "minimal"
      }
    }
  }
}
