# Configurações de fuso horário e ambiente para o Home Assistant
TZ=America/Fortaleza

# Credenciais MQTT (usadas pelo HASS.Agent no Windows e pela integração MQTT no Home Assistant)
MQTT_BROKER_HOST=100.x.y.z  # IP Tailscale da sua VPS
MQTT_BROKER_PORT=1883
MQTT_USERNAME=hass
MQTT_PASSWORD=sua_senha_segura_aqui
