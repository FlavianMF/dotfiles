#!/usr/bin/env bash
# Sobe o llama-server no WSL2 como backend único dos agentes locais (opencode e Traycer).
# Uso: llm-serve [main|coder7b|qwen35b-moe|deepseek14b|coder14b|ARQUIVO.gguf|USUARIO/REPO[:QUANT]] [args extras]
# Porta e host: LLM_PORT (8080) e 127.0.0.1. Um modelo residente por vez (-np 1).
set -euo pipefail

PORT="${LLM_PORT:-8080}"
CTX="${LLM_CTX:-32768}"
THREADS="${LLM_THREADS:-6}"
BASE="http://127.0.0.1:${PORT}"

command -v llama-server >/dev/null || { echo "llama-server não está no PATH. Rode: llama-build-sm120a" >&2; exit 1; }

# Já no ar: não suba uma segunda instância. O /health devolve 503 enquanto o -hf baixa e o
# modelo carrega, então confira também o processo.
if curl -fsS -m 2 "$BASE/health" >/dev/null 2>&1; then
  echo "llama-server já responde em $BASE"
  exit 0
fi
if pgrep -x llama-server >/dev/null; then
  echo "llama-server já está rodando, mas ainda não responde (baixando ou carregando o modelo). Aguarde e rode llm-health." >&2
  exit 0
fi

# Um modelo residente do Ollama no Windows disputa a mesma VRAM. Descarregue antes de subir.
# zsh/ollama.zsh resolve OLLAMA_BASE_URL (localhost com rede espelhada, gateway sem ela).
OLLAMA_URL="${OLLAMA_BASE_URL:-http://127.0.0.1:11434/v1}"
OLLAMA_URL="${OLLAMA_URL%/v1}"
if loaded="$(curl -fsS -m 2 "$OLLAMA_URL/api/ps" 2>/dev/null)"; then
  for m in $(jq -r '.models[].name' <<<"$loaded" 2>/dev/null); do
    echo "Descarregando '$m' do Ollama para liberar a VRAM"
    curl -fsS -m 10 "$OLLAMA_URL/api/generate" -d "{\"model\":\"$m\",\"keep_alive\":0}" >/dev/null || true
  done
else
  echo "Aviso: o Ollama não respondeu em $OLLAMA_URL. Se ele mantiver um modelo na VRAM, rode 'ollama stop' no Windows." >&2
fi

spec="${1:-main}"
[[ $# -gt 0 ]] && shift

model_args=()
alias_name=""
extra=()

case "$spec" in
  main)
    # Perfil principal: MoE de código com offload de experts.
    model_args=(-hf "${LLM_MAIN_HF:-ggml-org/gpt-oss-20b-GGUF}")
    alias_name="${LLM_MAIN_ALIAS:-gpt-oss-20b}"
    ;;
  coder7b)
    # Perfil Qwen 2.5 Coder 7B Instruct: 100% offload na VRAM da RTX 5050 (~4,8 GB VRAM, ~46 tok/s)
    model_args=(-hf "${LLM_CODER7B_HF:-Qwen/Qwen2.5-Coder-7B-Instruct-GGUF:Q4_K_M}")
    alias_name="${LLM_CODER7B_ALIAS:-qwen2.5-coder-7b}"
    ;;
  qwen35b-moe)
    # Perfil Qwen 3.6 35B-A3B MoE: raciocínio nativo, offload de 30 experts para CPU, sem mmproj
    local_q35="/home/flv/.cache/huggingface/hub/models--unsloth--Qwen3.6-35B-A3B-GGUF/snapshots/a483e9e6cbd595906af30beda3187c2663a1118c/Qwen3.6-35B-A3B-UD-IQ4_XS.gguf"
    if [[ -f "$local_q35" ]]; then
      model_args=(-m "$local_q35")
    else
      model_args=(-hf "${LLM_QWEN35B_HF:-unsloth/Qwen3.6-35B-A3B-GGUF:UD-IQ3_S}")
    fi
    alias_name="${LLM_QWEN35B_ALIAS:-qwen3.6-35b-a3b}"
    extra+=(-ngl 99 --n-cpu-moe 30 -fit off)
    CTX="${LLM_CTX:-16384}"
    ;;
  deepseek14b)
    # Perfil DeepSeek-R1-Distill-Qwen-14B: raciocínio estendido para lógica complexa
    model_args=(-hf "${LLM_DEEPSEEK14B_HF:-bartowski/DeepSeek-R1-Distill-Qwen-14B-GGUF:Q4_K_M}")
    alias_name="${LLM_DEEPSEEK14B_ALIAS:-deepseek-r1-14b}"
    extra+=(-ngl 30)
    CTX="${LLM_CTX:-16384}"
    ;;
  coder14b)
    # Perfil Qwen 2.5 Coder 14B: modelo denso com inteligência superior ao 7B
    model_args=(-hf "${LLM_CODER14B_HF:-Qwen/Qwen2.5-Coder-14B-Instruct-GGUF:Q4_K_M}")
    alias_name="${LLM_CODER14B_ALIAS:-qwen2.5-coder-14b}"
    extra+=(-ngl 30)
    CTX="${LLM_CTX:-16384}"
    ;;
  *.gguf)
    [[ -f "$spec" ]] || { echo "Arquivo não existe: $spec" >&2; exit 1; }
    model_args=(-m "$spec")
    alias_name="$(basename "$spec" .gguf)"
    ;;
  */*)
    model_args=(-hf "$spec")
    alias_name="${spec##*/}"
    ;;
  *)
    echo "Perfil desconhecido: $spec. Use main, coder7b, qwen35b-moe, deepseek14b, coder14b, um arquivo .gguf ou USUARIO/REPO[:QUANT]." >&2
    exit 2
    ;;
esac

# Suporte a LLM_LOAD_MODE (-lm) e ajuste de --n-cpu-moe manual
[[ -n "${LLM_LOAD_MODE:-}" ]] && extra+=(-lm "$LLM_LOAD_MODE")
[[ -n "${LLM_N_CPU_MOE:-}" ]] && extra+=(--n-cpu-moe "$LLM_N_CPU_MOE" -fit off)

echo "llama-server em $BASE: modelo '$alias_name', contexto $CTX"
exec llama-server "${model_args[@]}" --alias "$alias_name" \
  --host 127.0.0.1 --port "$PORT" -np 1 -c "$CTX" \
  --threads "$THREADS" -fa on -ctk q8_0 -ctv q8_0 \
  --no-webui "${extra[@]}" "$@"
