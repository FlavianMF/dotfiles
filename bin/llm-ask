#!/usr/bin/env bash
# llm-ask: chamada direta ao llama-server local em bounded context (sem ferramentas, sem histórico).
# Suporta extração de blocos cercados, modo raw, think extraction e aplicação determinística (--apply).
# Uso: llm-ask [opções] <arquivo-prompt-usuario> [arquivo-prompt-sistema]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

DEFAULT_SYS="$ROOT_DIR/agents/local-llm/system.txt"
if [[ ! -f "$DEFAULT_SYS" && -f "$HOME/dotfiles/agents/local-llm/system.txt" ]]; then
    DEFAULT_SYS="$HOME/dotfiles/agents/local-llm/system.txt"
fi

PORT="${LLM_PORT:-8080}"
TEMP="0.2"
MAX_TOKENS="6000"
RAW=0
SHOW_THINK=0
DRY_RUN=0
APPLY_TARGET=""
GRAMMAR_FILE=""
ARGS=()

show_help() {
    cat <<'HELP'
llm-ask: chamada direta ao llama-server local em bounded context (sem ferramentas, sem histórico).
Uso: llm-ask [opções] <arquivo-prompt-usuario> [arquivo-prompt-sistema]

Argumentos:
  arquivo-prompt-usuario   Arquivo com o prompt do usuário (ou '-' para stdin)
  arquivo-prompt-sistema   (Opcional) System prompt (padrão: agents/local-llm/system.txt)

Opções:
  -t, --temp FLOAT         Temperatura de amostragem (padrão: 0.2)
  -p, --port PORT          Porta do llama-server (padrão: 8080 ou $LLM_PORT)
  -m, --max-tokens N       Máximo de tokens gerados (padrão: 6000)
  --raw                    Retorna a resposta bruta completa sem extrair bloco de código
  --think                  Exibe apenas o raciocínio (<think>...</think> ou reasoning_content)
  --apply <arquivo>        Aplica o diff ou bloco search-replace gerado diretamente ao arquivo
  --grammar <arquivo>      Aplica uma gramática GBNF do llama-server para amostragem estrita
  -d, --dry-run            Imprime o payload JSON formatado sem enviar a requisição
  -h, --help               Exibe esta mensagem de ajuda
HELP
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -t|--temp)
            [[ $# -gt 1 ]] || { echo "Erro: --temp requer um valor." >&2; exit 1; }
            TEMP="$2"
            shift 2
            ;;
        -p|--port)
            [[ $# -gt 1 ]] || { echo "Erro: --port requer um valor." >&2; exit 1; }
            PORT="$2"
            shift 2
            ;;
        -m|--max-tokens)
            [[ $# -gt 1 ]] || { echo "Erro: --max-tokens requer um valor." >&2; exit 1; }
            MAX_TOKENS="$2"
            shift 2
            ;;
        --raw)
            RAW=1
            shift
            ;;
        --think)
            SHOW_THINK=1
            shift
            ;;
        --apply)
            [[ $# -gt 1 ]] || { echo "Erro: --apply requer o caminho do arquivo alvo." >&2; exit 1; }
            APPLY_TARGET="$2"
            shift 2
            ;;
        --grammar)
            [[ $# -gt 1 ]] || { echo "Erro: --grammar requer o arquivo de gramática GBNF." >&2; exit 1; }
            GRAMMAR_FILE="$2"
            shift 2
            ;;
        -d|--dry-run)
            DRY_RUN=1
            shift
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

if [[ ${#ARGS[@]} -eq 0 ]]; then
    echo "Erro: Arquivo de prompt do usuário é obrigatório." >&2
    show_help >&2
    exit 1
fi

USER_INPUT="${ARGS[0]}"
SYS_FILE="${ARGS[1]:-$DEFAULT_SYS}"

command -v jq >/dev/null 2>&1 || { echo "Erro: jq não está instalado no PATH." >&2; exit 1; }

tmp_user=""
if [[ "$USER_INPUT" == "-" ]]; then
    tmp_user="$(mktemp)"
    cat > "$tmp_user"
    USER_FILE="$tmp_user"
else
    USER_FILE="$USER_INPUT"
    if [[ ! -f "$USER_FILE" ]]; then
        echo "Erro: Arquivo de prompt do usuário não encontrado: '$USER_FILE'" >&2
        exit 1
    fi
fi

cleanup() {
    if [[ -n "$tmp_user" && -f "$tmp_user" ]]; then
        rm -f "$tmp_user"
    fi
}
trap cleanup EXIT

if [[ ! -f "$SYS_FILE" ]]; then
    echo "Erro: Arquivo de prompt de sistema não encontrado: '$SYS_FILE'" >&2
    exit 1
fi

grammar_arg=""
if [[ -n "$GRAMMAR_FILE" ]]; then
    if [[ ! -f "$GRAMMAR_FILE" ]]; then
        echo "Erro: Arquivo de gramática não encontrado: '$GRAMMAR_FILE'" >&2
        exit 1
    fi
    grammar_arg="$(<"$GRAMMAR_FILE")"
fi

PAYLOAD="$(jq -n \
    --rawfile sys "$SYS_FILE" \
    --rawfile usr "$USER_FILE" \
    --argjson temp "$TEMP" \
    --argjson max_tokens "$MAX_TOKENS" \
    --arg grammar "$grammar_arg" \
    '{
        model: "local",
        cache_prompt: true,
        max_tokens: $max_tokens,
        temperature: $temp,
        top_p: 0.9,
        top_k: 20,
        min_p: 0.05,
        repeat_penalty: 1.05,
        messages: [
            {role: "system", content: $sys},
            {role: "user", content: $usr}
        ]
    } + (if $grammar != "" then {grammar: $grammar} else {} end)')"

if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "$PAYLOAD"
    exit 0
fi

API_URL="http://127.0.0.1:${PORT}/v1/chat/completions"

if ! RESPONSE="$(echo "$PAYLOAD" | curl -fsS -m 300 "$API_URL" -H 'Content-Type: application/json' -d @- 2>&1)"; then
    echo "Erro: Falha na comunicação com o llama-server em $API_URL." >&2
    echo "Detalhes: $RESPONSE" >&2
    echo "Verifique se o backend local está em execução (llm-serve)." >&2
    exit 1
fi

CONTENT="$(echo "$RESPONSE" | jq -r '.choices[0].message.content // empty')"
REASONING="$(echo "$RESPONSE" | jq -r '.choices[0].message.reasoning_content // empty')"

if [[ -z "$CONTENT" && -z "$REASONING" ]]; then
    echo "Erro: Resposta vazia ou inesperada da API local:" >&2
    echo "$RESPONSE" >&2
    exit 1
fi

# Se solicitado apenas o pensamento
if [[ "$SHOW_THINK" -eq 1 ]]; then
    if [[ -n "$REASONING" ]]; then
        echo "$REASONING"
    elif grep -q '<think>' <<<"$CONTENT"; then
        python3 -c '
import sys, re
text = sys.stdin.read()
m = re.search(r"<think>(.*?)</think>", text, re.DOTALL)
if m:
    print(m.group(1).strip())
' <<<"$CONTENT"
    else
        echo "Nenhum raciocínio explícito retornado pelo modelo."
    fi
    exit 0
fi

if [[ "$RAW" -eq 1 ]]; then
    FINAL_OUTPUT="$CONTENT"
else
    # Extrai o conteúdo dentro do bloco cercado (``` ... ```)
    if grep -q '^```' <<<"$CONTENT"; then
        FINAL_OUTPUT="$(echo "$CONTENT" | awk '/^```/{f=!f; next} f')"
    else
        FINAL_OUTPUT="$CONTENT"
    fi
fi

# Aplicação automática ao arquivo alvo se solicitado
if [[ -n "$APPLY_TARGET" ]]; then
    if [[ ! -f "$APPLY_TARGET" ]]; then
        echo "Erro: Arquivo alvo para --apply não encontrado: '$APPLY_TARGET'" >&2
        exit 1
    fi

    # Caso 1: Bloco SEARCH/REPLACE
    if grep -F -q '<<<<<<< SEARCH' <<<"$FINAL_OUTPUT"; then
        python3 -c '
import sys, re
target_file = sys.argv[1]
diff_content = sys.stdin.read()
with open(target_file, "r", encoding="utf-8") as f:
    content = f.read()

pattern = re.compile(r"<<<<<<< SEARCH\s*\n(.*?)\n=======\s*\n(.*?)\n>>>>>>> REPLACE", re.DOTALL)
matches = pattern.findall(diff_content)
if not matches:
    print("Erro: Nenhum bloco SEARCH/REPLACE válido encontrado.", file=sys.stderr)
    sys.exit(1)

for search, replace in matches:
    search_norm = search.replace("\r\n", "\n")
    content_norm = content.replace("\r\n", "\n")
    if search not in content and search_norm not in content_norm:
        print(f"Erro: Trecho de busca não confere no arquivo:\n{search}", file=sys.stderr)
        sys.exit(1)
    if search in content:
        content = content.replace(search, replace, 1)
    else:
        content = content_norm.replace(search_norm, replace, 1)

with open(target_file, "w", encoding="utf-8") as f:
    f.write(content)
print(f"✓ {len(matches)} bloco(s) Search/Replace aplicado(s) com sucesso em {target_file}.")
' "$APPLY_TARGET" <<<"$FINAL_OUTPUT"
        exit $?
    fi

    # Caso 2: Unified diff (git apply com recount)
    if grep -E -q '^(diff --git|--- |\+\+\+ |@@ )' <<<"$FINAL_OUTPUT"; then
        tmp_patch="$(mktemp)"
        echo "$FINAL_OUTPUT" > "$tmp_patch"
        if git apply --recount --ignore-space-change "$tmp_patch" 2>/dev/null; then
            echo "✓ Unified diff aplicado com sucesso via git apply (--recount)."
            rm -f "$tmp_patch"
            exit 0
        elif patch -p1 --batch < "$tmp_patch" 2>/dev/null; then
            echo "✓ Unified diff aplicado com sucesso via patch."
            rm -f "$tmp_patch"
            exit 0
        else
            echo "Erro: git apply / patch falhou ao aplicar o diff unificado." >&2
            git apply --recount --check "$tmp_patch" || true
            rm -f "$tmp_patch"
            exit 1
        fi
    fi

    echo "Aviso: A saída não continha blocos diff nem search-replace identificáveis." >&2
fi

echo "$FINAL_OUTPUT"
