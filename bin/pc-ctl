#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/pc-ctl-log.sh
source "$SCRIPT_DIR/lib/pc-ctl-log.sh"

WIN_DIR="${WIN_SYS_DIR:-/mnt/c/Windows/System32}"
PS_DIR="${WIN_PS_DIR:-$WIN_DIR/WindowsPowerShell/v1.0}"

DRY_RUN=0
ARGS=()

show_help() {
    cat <<'EOF'
Uso: pc-ctl [opções] <comando> [argumentos]

Utilitário de controle do sistema host Windows e integração a partir do WSL2.

Comandos:
  shutdown [--force]  Desliga o computador host (10s com aviso ou imediato com --force)
  abort               Cancela um desligamento agendado
  restart             Reinicia o computador host imediatamente
  sleep               Coloca o computador host em suspensão
  lock                Bloqueia a sessão do computador host
  app <nome>          Abre aplicativo no host (obsidian, wt, terminal)
  power-mode <perfil> Altera perfil de energia (eco, balanced, llm-boost, max, status) [--ttl N]
  wake-setup          Configura permissões, wake timers e tarefa pc-ctl-power no host Windows
  status              Exibe o status dos serviços e interoperabilidade

Opções:
  -d, --dry-run       Apenas imprime o comando sem executá-lo
  -h, --help          Exibe este menu de ajuda
EOF
}

execute() {
    if [[ "$DRY_RUN" -eq 1 ]]; then
        echo "[DRY-RUN] $*"
    else
        "$@"
    fi
}

cmd_status() {
    echo "=== Status do Sistema ==="
    echo -n "Windows Host: "
    if [[ -f "$WIN_DIR/cmd.exe" ]]; then
        if timeout 2 "$WIN_DIR/cmd.exe" /c "echo OK" >/dev/null 2>&1; then
            echo "Interoperabilidade ativa (OK)"
        else
            echo "Indisponível (Falha de execução)"
        fi
    else
        echo "Binário cmd.exe não encontrado em $WIN_DIR"
    fi

    echo -n "SSH: "
    local ssh_status
    ssh_status="$(systemctl is-active ssh 2>/dev/null || true)"
    if [[ -z "$ssh_status" ]]; then
        ssh_status="inactive"
    fi
    echo "$ssh_status"

    echo -n "Traycer: "
    if pgrep -f traycer >/dev/null 2>&1; then
        echo "running"
    else
        echo "stopped"
    fi

    echo -n "Power Profile: "
    local state_file="${PC_CTL_STATE_FILE:-/mnt/c/ProgramData/pc-ctl/state.json}"
    if [[ -f "$state_file" ]]; then
        local p_name
        p_name="$(jq -r '.active_profile // "desconhecido"' "$state_file" 2>/dev/null || echo "desconhecido")"
        echo "$p_name"
    else
        echo "desconhecido"
    fi
}

cmd_wake_setup() {
    local install_ps="$SCRIPT_DIR/powershell/pc-ctl/Install-PcCtl.ps1"
    local win_install_ps
    if ! win_install_ps="$(wslpath -w "$install_ps" 2>/dev/null)"; then
        echo "Erro: wslpath não converteu '$install_ps' para um caminho Windows." >&2
        pc_ctl_log --cmd "wake-setup" --result "failed" --reason "wslpath_failed"
        return 1
    fi

    # Uma única elevação: Install-PcCtl.ps1 copia os scripts, ajusta a ACL, habilita os
    # wake timers (powercfg) e registra a tarefa pc-ctl-power. O ExitCode volta para cá.
    local rc=0
    execute "$PS_DIR/powershell.exe" -NoProfile -Command "\$p = Start-Process powershell.exe -Verb RunAs -Wait -PassThru -ArgumentList '-NoProfile -ExecutionPolicy Bypass -File \"$win_install_ps\"'; exit \$p.ExitCode" || rc=$?

    if [[ "$rc" -ne 0 ]]; then
        echo "Erro: o script elevado Install-PcCtl.ps1 falhou (código $rc)." >&2
        pc_ctl_log --cmd "wake-setup" --result "failed" --reason "install_failed"
        return 1
    fi

    if [[ "$DRY_RUN" -eq 1 ]]; then
        pc_ctl_log --cmd "wake-setup" --result "dry-run" --reason "dry_run"
    else
        pc_ctl_log --cmd "wake-setup" --result "applied" --reason "ok"
        echo "wake-setup concluído com sucesso."
    fi
}

check_power_line_status() {
    if [[ -n "${PC_CTL_MOCK_POWER_LINE:-}" ]]; then
        echo "$PC_CTL_MOCK_POWER_LINE"
        return 0
    fi

    # Falha fechada: se o powershell.exe falhar ou não responder, o estado é Unknown (nunca Online).
    local ps_output rc=0
    ps_output="$("$PS_DIR/powershell.exe" -NoProfile -Command "Add-Type -AssemblyName System.Windows.Forms; [System.Windows.Forms.SystemInformation]::PowerStatus.PowerLineStatus" 2>/dev/null)" || rc=$?
    ps_output="$(tr -d '\r\n ' <<<"$ps_output")"
    if [[ "$rc" -ne 0 || -z "$ps_output" ]]; then
        echo "Unknown"
    else
        echo "$ps_output"
    fi
}

parse_ttl_minutes() {
    local raw="$1"
    local minutes=0
    if [[ "$raw" =~ ^([0-9]+(\.[0-9]+)?)h$ ]]; then
        local hours="${BASH_REMATCH[1]}"
        minutes="$(python3 -c "import sys; print(int(round(float(sys.argv[1]) * 60)))" "$hours")"
    elif [[ "$raw" =~ ^([0-9]+)m$ ]]; then
        minutes="${BASH_REMATCH[1]}"
    elif [[ "$raw" =~ ^([0-9]+)$ ]]; then
        minutes="$raw"
    else
        echo "Erro: Formato de TTL inválido: '$raw'. Exemplos válidos: 90m, 2h, 120" >&2
        return 1
    fi
    echo "$minutes"
}

cmd_power_mode() {
    if [[ $# -eq 0 ]]; then
        echo "Erro: Nenhum perfil informado." >&2
        echo "Perfis válidos: eco, balanced, llm-boost, max, status" >&2
        return 1
    fi

    local profile="$1"
    shift

    if [[ "$profile" == "status" ]]; then
        local state_file="${PC_CTL_STATE_FILE:-/mnt/c/ProgramData/pc-ctl/state.json}"
        if [[ -f "$state_file" ]]; then
            local active ttl expires
            active="$(jq -r '.active_profile // "desconhecido"' "$state_file")"
            ttl="$(jq -r '.ttl_minutes // 0' "$state_file")"
            expires="$(jq -r '.expires_at // "sem expiracao"' "$state_file")"
            echo "Perfil ativo: $active"
            echo "TTL: ${ttl}m (Expira em: $expires)"
            local last_result last_reason last_profile last_at
            last_result="$(jq -r '.last_result // empty' "$state_file")"
            if [[ -n "$last_result" ]]; then
                last_reason="$(jq -r '.last_reason // "-"' "$state_file")"
                last_profile="$(jq -r '.last_profile // "-"' "$state_file")"
                last_at="$(jq -r '.last_at // "-"' "$state_file")"
                echo "Último pedido: perfil $last_profile, resultado $last_result ($last_reason), em $last_at"
            fi
        else
            echo "Perfil ativo: Desconhecido (state.json não encontrado)"
        fi
        return 0
    fi

    case "$profile" in
        eco|balanced|llm-boost|max)
            ;;
        *)
            echo "Erro: Perfil desconhecido: '$profile'" >&2
            echo "Perfis válidos: eco, balanced, llm-boost, max, status" >&2
            return 1
            ;;
    esac

    local ttl_minutes=0
    if [[ "$profile" == "llm-boost" || "$profile" == "max" ]]; then
        ttl_minutes=120 # Padrão: 2 horas
    fi

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ttl)
                if [[ $# -lt 2 ]]; then
                    echo "Erro: --ttl requer um valor de duração." >&2
                    return 1
                fi
                ttl_minutes="$(parse_ttl_minutes "$2")"
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    # Validação do teto de TTL (4 horas = 240 minutos)
    if [[ "$ttl_minutes" -gt 240 ]]; then
        echo "Erro: TTL de ${ttl_minutes}m excede o teto permitido de 240m (4h)." >&2
        pc_ctl_log --cmd "power-mode" --result "refused" --reason "ttl_exceeded" --profile "$profile"
        return 1
    fi

    # Verificação de bateria / tomada
    local power_line
    power_line="$(check_power_line_status)"
    if [[ "$power_line" != "Online" && ("$profile" == "llm-boost" || "$profile" == "max") ]]; then
        if [[ "$power_line" == "Unknown" ]]; then
            echo "Erro: Perfil '$profile' recusado: não foi possível ler o estado da tomada (Unknown)." >&2
            pc_ctl_log --cmd "power-mode" --result "refused" --reason "power_unknown" --profile "$profile"
        else
            echo "Erro: Perfil '$profile' recusado: computador está operando na bateria." >&2
            pc_ctl_log --cmd "power-mode" --result "refused" --reason "on_battery" --profile "$profile"
        fi
        return 1
    fi

    local until=""
    if [[ "$ttl_minutes" -gt 0 ]]; then
        until="$(python3 -c "import datetime; print((datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(minutes=$ttl_minutes)).strftime('%Y-%m-%dT%H:%M:%SZ'))")"
    fi

    if [[ "$DRY_RUN" -eq 1 ]]; then
        echo "[DRY-RUN] Escrevendo em C:\\ProgramData\\pc-ctl\\request.json: {\"profile\": \"$profile\", \"ttl_minutes\": $ttl_minutes}"
        echo "[DRY-RUN] $WIN_DIR/schtasks.exe /run /tn \"pc-ctl-power\""
        if [[ -n "$until" ]]; then
            pc_ctl_log --cmd "power-mode" --result "dry-run" --reason "dry_run" --profile "$profile" --until "$until"
        else
            pc_ctl_log --cmd "power-mode" --result "dry-run" --reason "dry_run" --profile "$profile"
        fi
        return 0
    fi

    local req_file="${PC_CTL_REQUEST_FILE:-/mnt/c/ProgramData/pc-ctl/request.json}"
    local req_dir
    req_dir="$(dirname "$req_file")"
    if [[ ! -d "$req_dir" ]]; then
        mkdir -p "$req_dir" 2>/dev/null || true
    fi

    python3 -c '
import json, sys
data = {"profile": sys.argv[1], "ttl_minutes": int(sys.argv[2])}
with open(sys.argv[3], "w", encoding="utf-8") as f:
    json.dump(data, f)
' "$profile" "$ttl_minutes" "$req_file"

    execute "$WIN_DIR/schtasks.exe" /run /tn "pc-ctl-power"

    # O schtasks /run é assíncrono: só o pedido foi enviado. A tarefa elevada grava o resultado real
    # (applied|refused|failed) no state.json, e "power-mode status" lê esse arquivo.
    if [[ -n "$until" ]]; then
        pc_ctl_log --cmd "power-mode" --result "requested" --reason "task_started" --profile "$profile" --until "$until"
    else
        pc_ctl_log --cmd "power-mode" --result "requested" --reason "task_started" --profile "$profile"
    fi

    echo "Perfil '$profile' solicitado (TTL: ${ttl_minutes}m). Confira o resultado com: pc-ctl power-mode status"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run|-d)
            DRY_RUN=1
            shift
            ;;
        --help|-h)
            show_help
            exit 0
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

if [[ ${#ARGS[@]} -eq 0 ]]; then
    echo "Erro: Nenhum comando informado." >&2
    show_help >&2
    exit 1
fi

set -- "${ARGS[@]}"
COMMAND="$1"
shift

case "$COMMAND" in
    shutdown)
        FORCE=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --force|-f)
                    FORCE=1
                    shift
                    ;;
                *)
                    shift
                    ;;
            esac
        done
        if [[ "$FORCE" -eq 1 ]]; then
            execute "$WIN_DIR/shutdown.exe" /s /t 0 /f
        else
            execute "$WIN_DIR/shutdown.exe" /s /t 10 /c "Desligamento acionado via pc-ctl"
        fi
        ;;
    abort)
        execute "$WIN_DIR/shutdown.exe" /a
        ;;
    restart)
        execute "$WIN_DIR/shutdown.exe" /r /t 0 /f
        ;;
    sleep)
        # S3 explícito. rundll32 powrprof.dll,SetSuspendState hiberna quando o hibernar está habilitado.
        execute "$PS_DIR/powershell.exe" -NoProfile -WindowStyle Hidden -Command \
            "Add-Type -AssemblyName System.Windows.Forms; [System.Windows.Forms.Application]::SetSuspendState('Suspend', \$false, \$false) | Out-Null"
        ;;
    lock)
        execute "$WIN_DIR/rundll32.exe" user32.dll,LockWorkStation
        ;;
    app)
        if [[ $# -eq 0 || -z "${1:-}" ]]; then
            echo "Erro: Nome da aplicação não informado." >&2
            echo "Aplicações válidas: obsidian, wt, terminal" >&2
            exit 1
        fi
        APP_NAME="$1"
        case "$APP_NAME" in
            obsidian)
                execute "$PS_DIR/powershell.exe" -NoProfile -WindowStyle Hidden -Command "Start-Process obsidian"
                ;;
            wt|terminal)
                execute "$PS_DIR/powershell.exe" -NoProfile -WindowStyle Hidden -Command "Start-Process wt"
                ;;
            *)
                echo "Erro: Aplicacao desconhecida: $APP_NAME" >&2
                echo "Aplicações válidas: obsidian, wt, terminal" >&2
                exit 1
                ;;
        esac
        ;;
    wake-setup)
        cmd_wake_setup
        ;;
    power-mode)
        cmd_power_mode "$@"
        ;;
    status)
        cmd_status
        ;;
    help)
        show_help
        exit 0
        ;;
    *)
        echo "Erro: Comando desconhecido: '$COMMAND'" >&2
        show_help >&2
        exit 1
        ;;
esac
